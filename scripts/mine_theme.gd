class_name MineTheme
extends RefCounted
## The look of one level of the mine: which textures it uses (generated by
## tools/gen_art.py into assets/art/<key>/), lighting colours, colour grading,
## ambient particles and the props that decorate its rooms.

const ART := "res://assets/art/"

var key := ""
var title := ""
var ambient := Color(0.2, 0.18, 0.17)      # CanvasModulate (how dark it is)
var lantern := Color(1.0, 0.72, 0.4)       # lantern light colour
var tint := Color(1, 1, 1)                 # post-process colour grade
var saturation := 0.9
var contrast := 1.08
var fog := Color(0.6, 0.5, 0.4, 0.05)
var particles := "dust"                    # dust, drips, embers, sparkles, ash
var props: Array[String] = []              # decor that can appear on the floor/walls

static var _themes: Array[MineTheme] = []
static var _tex_cache: Dictionary = {}


static func _make(k: String, t: String, amb: Color, lan: Color, tin: Color, sat: float, con: float,
		fg: Color, part: String, prop_list: Array[String]) -> MineTheme:
	var m := MineTheme.new()
	m.key = k
	m.title = t
	m.ambient = amb
	m.lantern = lan
	m.tint = tin
	m.saturation = sat
	m.contrast = con
	m.fog = fg
	m.particles = part
	m.props = prop_list
	return m


static func all() -> Array[MineTheme]:
	if _themes.is_empty():
		_themes = [
			_make("shafts", "The Upper Shafts", Color(0.21, 0.18, 0.16), Color(1.0, 0.70, 0.40),
				Color(1.06, 0.99, 0.90), 0.92, 1.08, Color(0.75, 0.6, 0.45, 0.05), "dust",
				["rail", "crate", "barrel", "minecart", "ore"]),
			_make("granite", "Deeper", Color(0.16, 0.17, 0.20), Color(1.0, 0.76, 0.48),
				Color(0.95, 0.99, 1.06), 0.8, 1.1, Color(0.55, 0.6, 0.7, 0.05), "dust",
				["rail", "crate", "minecart", "ore"]),
			_make("flooded", "The Old Workings", Color(0.12, 0.16, 0.16), Color(1.0, 0.82, 0.56),
				Color(0.9, 1.03, 1.0), 0.85, 1.1, Color(0.45, 0.6, 0.6, 0.07), "drips",
				["puddle", "barrel", "bones", "ore"]),
			_make("coal", "No Way Back", Color(0.12, 0.10, 0.10), Color(1.0, 0.55, 0.25),
				Color(1.08, 0.95, 0.87), 0.95, 1.14, Color(0.4, 0.3, 0.25, 0.06), "embers",
				["minecart", "rail", "crate", "ore"]),
			_make("crystal", "Where The Light Ends", Color(0.11, 0.10, 0.17), Color(0.72, 0.78, 1.0),
				Color(0.95, 0.95, 1.08), 1.05, 1.1, Color(0.5, 0.45, 0.8, 0.06), "sparkles",
				["crystals", "crystals", "bones", "ore"]),
			_make("halls", "The Wanderer's Halls", Color(0.13, 0.08, 0.08), Color(1.0, 0.40, 0.28),
				Color(1.1, 0.9, 0.88), 0.8, 1.16, Color(0.5, 0.2, 0.2, 0.07), "ash",
				["bones", "claws", "bones", "ore"]),
		]
	return _themes


## Level 1 = first theme ... level 6+ = the Wanderer's Halls.
static func for_level(level: int) -> MineTheme:
	var list := all()
	return list[clampi(level - 1, 0, list.size() - 1)]


## A repeating texture for this theme, with its normal map when there is one.
func tex(name: String) -> Texture2D:
	return MineTheme.load_tex(ART + key + "/" + name)


## Shared (not per-theme) art, e.g. "door", "lantern", "bruce".
static func shared(name: String) -> Texture2D:
	return load_tex(ART + "shared/" + name)


static func load_tex(base: String) -> Texture2D:
	if _tex_cache.has(base):
		return _tex_cache[base]
	var diffuse: Texture2D = load(base + ".png")
	var result: Texture2D = diffuse
	if ResourceLoader.exists(base + "_n.png"):
		var ct := CanvasTexture.new()
		ct.diffuse_texture = diffuse
		ct.normal_texture = load(base + "_n.png")
		ct.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
		ct.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		result = ct
	_tex_cache[base] = result
	return result
